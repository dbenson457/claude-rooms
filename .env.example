# Copy to .env and edit. Every setting is optional; the defaults run one local copy.

# Port and addresses to listen on (comma-separated).
# ROOM_PORT=4630
# ROOM_HOSTS=127.0.0.1
# Only these client IPs get an answer. Put a reverse proxy with its own login in front
# before adding anything but localhost: whoever reaches this page can drive Claude.
# ROOM_ALLOW=127.0.0.1

# Where Claude Code keeps its files, and where rooms keeps its own (offline list, uploads).
# CLAUDE_HOME=/home/you/.claude
# ROOM_DATA=/home/you/.claude/room-data

# Folder new tabs start in (default: your home folder).
# ROOM_CWD=/home/you/projects

# tmux tabs never shown as rooms, comma-separated (e.g. a bot running Claude in the background).
# ROOM_SKIP=claude-bot

# Optional extras
# A dashboard that frames the page as ?embed=1 and may call the API cross-origin:
# ROOM_HOME_ORIGIN=https://home.example.com
# A web terminal, opened by the >_ button:
# ROOM_TERM_URL=https://term.example.com
# This page's own public address (for "Open on its own" when embedded):
# ROOM_SELF_URL=https://rooms.example.com
# Flags for the pinned assistant room, e.g. its own prompt and settings:
# ROOM_ASSISTANT_ARGS=--permission-mode auto --append-system-prompt "$(cat ./assistant/prompt.md)"
# Status line output with the 5-hour limit (for "5h +3%" per turn):
# ROOM_LIMITS_FILE=/home/you/.claude/statusline-usage/.limits.json

# Tests (tests/*.mjs): the copy to drive, and where screenshots go.
# ROOM_URL=http://localhost:4631
# SHOTS=screenshots
# CHROMIUM_PATH=
